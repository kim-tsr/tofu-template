export PROXMOX_VE_API_TOKEN="terraform@pve!provider=$(security find-generic-password -s pve-token -w 2>/dev/null)"
export PROXMOX_VE_ENDPOINT="https://pxm-srv:8006/"
export PROXMOX_VE_INSECURE=true

if [[ -z "$PROXMOX_VE_API_TOKEN" ]]; then
  log_error "Token Proxmox introuvable dans le trousseau (service: pve-token)"
fi
